# If launched in background X11 event-bridge mode (--watch-x11), force GDK X11 backend
# BEFORE importing Gtk/Gdk so it passively listens to XFixes SelectionNotify events
# without creating any Wayland window or stealing focus.
if "--watch-x11" in sys.argv:
    os.environ["GDK_BACKEND"] = "x11"

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('GdkPixbuf', '2.0')
