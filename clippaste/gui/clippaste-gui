    def on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def load_history(self):
        for candidate in (HISTORY_FILE, "/dev/shm/clippaste/history.json"):
            if os.path.exists(candidate):
                try:
                    with open(candidate, "r", encoding="utf-8") as f:
                        return json.load(f)
                except Exception:
                    continue
        return []

    def load_and_populate(self, query=""):
        self.items = self.load_history()

        child = self.list_box.get_first_child()
        while child:
            next_child = child.get_next_sibling()
            self.list_box.remove(child)
            child = next_child

        filter_q = query.strip().lower()
        filtered = [
            i
            for i in self.items
            if not filter_q
            or (
                i.get("preview", "").lower().find(filter_q) != -1
                or (i.get("content") and i.get("content").lower().find(filter_q) != -1)
            )
        ]

        if not filtered:
            empty_row = Gtk.ListBoxRow()
            empty_label = Gtk.Label(
                label="<i>Chưa có nội dung copy tạm</i>", use_markup=True
            )
            empty_label.set_margin_top(28)
            empty_label.set_margin_bottom(28)
            empty_row.set_child(empty_label)
            empty_row.set_activatable(False)
            self.list_box.append(empty_row)
            return

        for item in filtered:
            row = ClipRow(
                item,
                on_paste_cb=self.paste_item,
                on_pin_cb=self.pin_item,
                on_delete_cb=self.delete_item,
            )
            self.list_box.append(row)

    def on_search_changed(self, entry):
        self.load_and_populate(entry.get_text())

    def on_row_activated(self, list_box, row):
        if isinstance(row, ClipRow):
            if getattr(row, "is_dragging", False):
                return
            self.paste_item(row.item)

    def paste_item(self, item):
        item_id = item.get("id")
        self.set_visible(False)
        self.close()
        if not send_daemon_command(f"PASTE\t{item_id}\n", ["paste", str(item_id)]):
            try:
                subprocess.Popen(
                    [DAEMON_BIN, "paste", str(item_id)],
                    start_new_session=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except Exception as e:
                sys.stderr.write(f"ClipPaste failed to run daemon paste: {e}\n")

    def pin_item(self, item):
        item_id = item.get("id")
        send_daemon_command(f"PIN\t{item_id}\n", ["pin", str(item_id)])
        self.load_and_populate(self.search_entry.get_text())

    def delete_item(self, item):
        item_id = item.get("id")
        send_daemon_command(f"DELETE\t{item_id}\n", ["delete", str(item_id)])
        self.load_and_populate(self.search_entry.get_text())

    def on_clear_clicked(self, btn):
        send_daemon_command("CLEAR\n", ["clear"])
        _THUMB_CACHE.clear()
        self.load_and_populate(self.search_entry.get_text())


class ClipPasteApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id=None,
            flags=Gio.ApplicationFlags.NON_UNIQUE,
        )
        self.win = None

    def do_activate(self):
        self.win = ClipPasteWindow(self)
        self.win.connect("destroy", self.on_window_destroy)
        self.win.present()
        try:
            if HAS_GLIB_UNIX:
                GLibUnix.signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, self.on_sigterm)
                GLibUnix.signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, self.on_sigterm)
            elif hasattr(GLib, "unix_signal_add"):
                GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, self.on_sigterm)
                GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, self.on_sigterm)
        except Exception:
            pass

    def on_sigterm(self):
        cleanup_pid()
        self.quit()
        return GLib.SOURCE_REMOVE

    def on_window_destroy(self, win):
        cleanup_pid()
        self.win = None
        self.quit()


def main():
    if "--watch-x11" in sys.argv:
        run_x11_clipboard_watcher()
        return

    check_and_toggle_instance()
    app = ClipPasteApp()
    try:
        app.run(sys.argv)
    finally:
        cleanup_pid()


if __name__ == "__main__":
    main()
